# Server / operator only. Never prefix service key with NEXT_PUBLIC_.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# web server only; use random 32+ byte value, shared across deployments
VIEWER_COOKIE_KEY=
VIEWER_ORIGIN=https://YOUR-VERCEL-HOST
# Tile URL must be HTTPS; select provider and comply with attribution/usage terms.
NEXT_PUBLIC_TILE_URL=
NEXT_PUBLIC_TILE_ATTRIBUTION=
# Local PostgreSQL integration only (scripts/test-db.mjs supplies this automatically)
TEST_DATABASE_URL=
